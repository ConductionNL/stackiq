{
  "id": "vng-swc",
  "name": "Previous VNG Softwarecatalogus export",
  "version": "1.0.0",
  "description": "How stackiq reads an organisation's export from the previous VNG Softwarecatalogus (xlsx, or csv with the same columns): one row per application in use, with its supplier, product, version, status, reference components and connections. The previous catalogue's ids become legacyId, so a second run finds what the first one wrote. Columns that neither this profile nor a pack names are never read.",
  "maxFileBytes": 10485760,
  "maxRowsPerSheet": 5000,
  "maxUncompressedBytes": 52428800,
  "maxPartBytes": 10485760,
  "maxSharedStrings": 200000,
  "maxReferencedStringBytes": 67108864,
  "sheets": [
    { "name": "Applicaties" }
  ],
  "csvSheet": "Applicaties",
  "keyColumn": "Gebruik ID",
  "nameColumn": "Pakket",
  "requiredColumns": ["Gebruik ID", "Leverancier", "Pakket"],
  "dateColumns": [],
  "idColumns": ["Gebruik ID", "Pakket ID", "Leverancier ID", "Leverancier KvK"],
  "legacyIdColumns": {
    "supplier": "Leverancier ID",
    "module": "Pakket ID",
    "usage": "Gebruik ID"
  },
  "linkColumns": {
    "referenceComponents": "Referentiecomponenten",
    "connections": "Koppelingen"
  },
  "linkSeparator": ";",
  "externalKeyPrefix": "vng-swc",
  "targets": ["supplier", "module", "version", "usage"],
  "editableTargets": [],
  "targetSchemas": {
    "supplier": "organization",
    "module": "module",
    "version": "moduleVersion",
    "usage": "usage"
  },
  "requiredMappings": {
    "supplier": ["name"],
    "module": ["name"],
    "version": [],
    "usage": []
  },
  "packs": {
    "supplier": "vng-swc-supplier.json",
    "module": "vng-swc-module.json",
    "version": "vng-swc-version.json",
    "usage": "vng-swc-usage.json"
  },
  "missingRecords": ["keep"]
}
