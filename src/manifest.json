{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "2.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Organisaties",
			"label": "Organisations",
			"icon": "icon-group",
			"route": "Organisaties",
			"order": 20
		},
		{
			"id": "Contactpersonen",
			"label": "Contacts",
			"icon": "icon-user",
			"route": "Contactpersonen",
			"order": 30
		},
		{
			"id": "Contracten",
			"label": "Contracts",
			"icon": "icon-file",
			"route": "Contracten",
			"order": 40
		},
		{
			"id": "Standaarden",
			"label": "Standards",
			"icon": "icon-checkmark",
			"route": "Standaarden",
			"order": 50
		},
		{
			"id": "Reviews",
			"label": "Reviews",
			"icon": "icon-comment",
			"route": "Reviews",
			"order": 60
		},
		{
			"id": "Komplianties",
			"label": "Compliance",
			"icon": "icon-checkmark",
			"route": "Komplianties",
			"order": 70
		},
		{
			"id": "Moduleversies",
			"label": "Module versions",
			"icon": "icon-files",
			"route": "Moduleversies",
			"order": 80
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://github.com/ConductionNL/SoftwareCatalogus",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 95
		},
		{
			"id": "SettingsMenu",
			"label": "Settings",
			"icon": "icon-settings",
			"route": "Settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{ "id": "dashboardHome", "title": "Dashboard", "type": "custom" }
				],
				"layout": [
					{ "id": 1, "widgetId": "dashboardHome", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 12 }
				]
			},
			"slots": {
				"widget-dashboardHome": "DashboardCustomView"
			}
		},
		{
			"id": "Organisaties",
			"route": "/organisaties",
			"type": "index",
			"title": "Organisations",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "organisatie",
				"columns": [
					"naam",
					"type",
					"status",
					"contactpersonen"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			},
			"_note": "Bespoke modals (OrganisationModal create/edit/copy, AddContactpersoonModal, activate/deactivate) and URL-hash deep-link wiring still happen via cross-store subscriptions in the consumer — flipped to type:\"index\" so the page uses CnIndexPage's standard table/cards/sidebar; the bespoke modal/dialog UX is opened through the registry instead of replacing the page shell"
		},
		{
			"id": "Contactpersonen",
			"route": "/contactpersonen",
			"type": "index",
			"title": "Contacts",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "contactpersoon",
				"columns": [
					"voornaam",
					"achternaam",
					"email",
					"telefoonnummer",
					"organisatie"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ContactpersoonDetail",
			"route": "/contactpersonen/:id",
			"type": "detail",
			"title": "Contact",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "contactpersoon",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Contracten",
			"route": "/contracten",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "contract",
				"columns": [
					"naam",
					"leverancier",
					{
						"key": "ingangsdatum",
						"label": "Start",
						"formatter": "date"
					},
					{
						"key": "einddatum",
						"label": "End",
						"formatter": "date"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ContractDetail",
			"route": "/contracten/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "contract",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Standaarden",
			"route": "/standaarden",
			"type": "index",
			"title": "Standards",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "standaard",
				"columns": [
					"naam",
					"versie",
					{
						"key": "categorie",
						"label": "Category",
						"widget": "badge"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "StandaardDetail",
			"route": "/standaarden/:id",
			"type": "detail",
			"title": "Standard",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "standaard",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Reviews",
			"route": "/reviews",
			"type": "index",
			"title": "Reviews",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "beoordeeling",
				"columns": [
					"titel",
					"auteur",
					"score",
					{
						"key": "datum",
						"label": "Date",
						"formatter": "date"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ReviewDetail",
			"route": "/reviews/:id",
			"type": "detail",
			"title": "Review",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "beoordeeling",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Komplianties",
			"route": "/komplianties",
			"type": "index",
			"title": "Compliance",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "compliancy",
				"columns": [
					"naam",
					"standaard",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					{
						"key": "datum",
						"label": "Date",
						"formatter": "date"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "KompliantieDetail",
			"route": "/komplianties/:id",
			"type": "detail",
			"title": "Compliance",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "compliancy",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Moduleversies",
			"route": "/moduleversies",
			"type": "index",
			"title": "Module versions",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "moduleVersie",
				"columns": [
					"versie",
					"module",
					{
						"key": "releaseDatum",
						"label": "Released",
						"formatter": "date"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ModuleversieDetail",
			"route": "/moduleversies/:id",
			"type": "detail",
			"title": "Module version",
			"config": {
				"register": "@resolve:voorzieningen_register",
				"schema": "moduleVersie",
				"sidebarProps": {
					"tabs": [
						{
							"id": "overview",
							"label": "Overview",
							"icon": "icon-info",
							"widgets": [
								{
									"type": "data"
								},
								{
									"type": "metadata"
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit trail",
							"icon": "icon-history",
							"widgets": [
								{
									"type": "audit-trail"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://softwarecatalog.conduction.nl"
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/softwarecatalog/api/settings",
				"sections": [
					{
						"title": "SoftwareCatalog",
						"component": "SoftwareCatalogSettingsPage"
					}
				]
			},
			"widgets": []
		}
	]
}
