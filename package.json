{
  "name": "softwarecatalog",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "sideEffects": true,
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:parity": "node tests/l10n/check-l10n.js --parity",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "check:vue-demi": "node scripts/check-vue-demi.js",
    "prebuild": "npm run check:vue-demi",
    "predev": "npm run check:vue-demi",
    "prewatch": "npm run check:vue-demi",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project smoke",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "check:manifest": "node tests/validate-manifest.js"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@codemirror/lang-json": "^6.0.0",
    "@conduction/nextcloud-vue": "2.2.0-vue3.3",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@toast-ui/editor": "^3.2.0",
    "@vueuse/core": "^14.4.0",
    "axe-core": "^4.12.1",
    "axios": "^1.7.3",
    "babel-loader": "^10.1.1",
    "css-loader": "~7.1.1",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "lodash": "^4.17.21",
    "marked": "^12.0.0",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.3",
    "remark-cli": "^12.0.1",
    "remark-lint-list-item-indent": "^4.0.0",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.40",
    "vue-codemirror6": "^1.0.0",
    "vue-draggable-plus": "^0.2.0",
    "vue-loader": "^17.4.2",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@babel/traverse": "^7.23.2",
    "babel-traverse": "npm:@babel/traverse@^7.23.2",
    "fast-xml-parser": ">=4.5.4",
    "immutable": ">=5.1.5",
    "json5": ">=1.0.2",
    "minimatch": "^3.1.2",
    "serialize-javascript": ">=7.0.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.5",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/config-helpers": "^0.5.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "browserslist": "^4.25.2",
    "caniuse-lite": "^1.0.30001733",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-webpack-plugin": "^4.2.0",
    "espree": "^11.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^10.2.0"
  }
}
